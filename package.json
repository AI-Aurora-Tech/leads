{
  "name": "aurora-leads",
  "version": "1.0.0",
  "description": "Prospecção automática de empresas + contato via WhatsApp Web para a AuroraTech",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "leads": "src/cli.js"
  },
  "scripts": {
    "buscar": "node --disable-warning=ExperimentalWarning src/cli.js buscar",
    "qualificar": "node --disable-warning=ExperimentalWarning src/cli.js qualificar",
    "gerar": "node --disable-warning=ExperimentalWarning src/cli.js gerar",
    "painel": "node --disable-warning=ExperimentalWarning src/cli.js painel",
    "leads": "node --disable-warning=ExperimentalWarning src/cli.js leads",
    "preview": "node --disable-warning=ExperimentalWarning src/cli.js preview",
    "enviar": "node --disable-warning=ExperimentalWarning src/cli.js enviar",
    "exportar": "node --disable-warning=ExperimentalWarning src/cli.js exportar",
    "test": "node --test test/*.test.js",
    "verificar": "node --disable-warning=ExperimentalWarning src/cli.js verificar",
    "navegador": "node --disable-warning=ExperimentalWarning src/cli.js navegador"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "puppeteer": "24.38.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  }
}
