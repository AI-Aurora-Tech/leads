# Chave da Google Places API (New) — https://console.cloud.google.com/apis/library/places.googleapis.com
# Opcional: sem ela, use --fonte maps (raspagem do Google Maps pelo navegador).
GOOGLE_PLACES_API_KEY=

# Opcional: personaliza cada mensagem com IA (Claude). Sem ela, usa os templates do config.json.
ANTHROPIC_API_KEY=

# Seu WhatsApp pessoal (com DDI+DDD) para receber alerta quando um lead responder. Ex: 5519999999999
OWNER_WHATSAPP=
