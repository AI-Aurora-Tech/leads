# Chave da Google Places API (New) — https://console.cloud.google.com/apis/library/places.googleapis.com
# Opcional: sem ela, use --fonte maps (raspagem do Google Maps pelo navegador).
GOOGLE_PLACES_API_KEY=

# Opcional: personaliza cada mensagem com IA (Claude). Sem ela, usa os templates do config.json.
ANTHROPIC_API_KEY=

# Seu WhatsApp pessoal (com DDI+DDD) para receber alerta quando um lead responder. Ex: 5519999999999
OWNER_WHATSAPP=

# ── WhatsApp Cloud API oficial (Meta) — usado com "canal": "cloud" ou --canal cloud ──
# Token permanente de Usuário do Sistema (Configurações do negócio > Usuários do sistema)
WHATSAPP_TOKEN=
# Em developers.facebook.com > seu app > WhatsApp > Configuração da API > "Identificação do número de telefone"
WHATSAPP_PHONE_NUMBER_ID=
# Qualquer texto que você inventar; o mesmo vai na configuração do webhook no app da Meta
WHATSAPP_VERIFY_TOKEN=
# Configurações do app > Básico > Chave secreta do app (valida que o webhook veio da Meta)
WHATSAPP_APP_SECRET=
